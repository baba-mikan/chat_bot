# Anthropic Claude API（必須）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Notion API（オプション - 空欄の場合はモックデータを使用）
# Integration作成: https://www.notion.so/my-integrations
# Database IDの取得方法: NotionデータベースのURLから取得
#   例: https://notion.so/workspace/abc123?v=xyz → abc123 がDatabase ID
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# OpenAI API（必須 - Embeddings生成用）
# https://platform.openai.com/ で取得
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
